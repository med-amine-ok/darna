# Copy to .env.local and fill in real values. Never commit .env.local.

# Secret used to sign the `darna_session` cookie (HMAC-SHA256).
# Required in production (the app refuses to start a session without it);
# must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
DARNA_SESSION_SECRET=

# Public origin used for canonical URLs, sitemap.xml and Open Graph links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Test mode (default ON while the site runs on demo data): one-click demo
# sign-in, works on plain http and without DARNA_SESSION_SECRET.
# Set to 0 at build time before real users or real data exist.
NEXT_PUBLIC_BLADUS_TEST_MODE=1
