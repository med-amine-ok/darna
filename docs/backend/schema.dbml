  rectification
  deletion
  opposition
}

// =====================================================================
// ACCOUNTS
// =====================================================================

Table user {
  id uuid [pk]
  email varchar(254) [note: 'Login email. Unique on lower(email) when not null.']
  email_verified_at timestamptz
  phone_e164 varchar(16) [note: 'E.164 phone, Algerian mobiles match ^\\+213[5-7][0-9]{8}$. Unique when not null.']
  phone_verified_at timestamptz [note: 'Required before the first booking (DEC-012).']
  password varchar(255) [note: 'Django password hash (argon2). Empty for phone-only accounts.']
  first_name_latin varchar(80)
  last_name_latin varchar(80)
  full_name_ar varchar(160) [note: 'Name in Arabic script, stored separately from the Latin form.']
  avatar_media_id uuid [ref: > media_asset.id]
  bio text [note: 'Short public introduction (max 500 characters).']
  spoken_languages "varchar(2)[]" [note: 'Languages the person speaks, ISO 639-1 codes, shown on host profiles.']
  home_commune_id int [ref: > commune.id, note: 'Where the person lives (optional, private).']
  address_line varchar(255) [note: 'Private postal address (optional); never shown publicly.']
  preferred_locale varchar(2) [not null, default: 'fr', note: 'en, fr or ar.']
  nationality_iso2 char(2) [note: 'Only when legally needed (foreign guest declaration, VERIFY).']
  status user_status [not null, default: 'active']
  is_staff boolean [not null, default: false]
  date_joined timestamptz [not null]
  last_login_at timestamptz
  deleted_at timestamptz [note: 'Soft delete.']
  anonymised_at timestamptz [note: 'Set when personal data was erased after a deletion request (BR-PRV-02).']
  Note: 'Every person: guest, host, organisation member, staff. Constraints: unique lower(email), unique phone_e164, check (email is not null or phone_e164 is not null). Auth tables (emails, MFA authenticators, sessions) come from django-allauth and are not repeated here.'
}

Table staff_profile {
  user_id uuid [pk, ref: - user.id]
  role staff_role_code [not null]
  status staff_status [not null, default: 'invited']
  invited_by_id uuid [ref: > user.id]
  invited_at timestamptz
  activated_at timestamptz
  deactivated_at timestamptz
  Note: 'Staff-only data. Permission checks read staff_role_permission for role. MFA must be enrolled before status can be active (BR-ACC-04).'
}

Table staff_permission {
  code varchar(64) [pk, note: 'e.g. hosts.approve, bookings.refund (34 codes today).']
  description text
}

Table staff_role_permission {
  role staff_role_code [pk]
  permission_code varchar(64) [pk, ref: > staff_permission.code]
  Note: 'One staff role today: admin, with every permission (DEC-016). The table stays so more roles can be added later without a redesign.'
}

Table consent_record {
  id uuid [pk]
  user_id uuid [not null, ref: > user.id]
  document varchar(32) [not null, note: 'terms, privacy, marketing.']
  version varchar(32) [not null]
  accepted boolean [not null]
  ip inet
  user_agent text
  created_at timestamptz [not null]
  Note: 'Append-only history of consents (BR-PRV-01). Latest row per (user, document) is current.'
}

Table favorite {
  id uuid [pk]
  user_id uuid [not null, ref: > user.id]
  listing_id uuid [ref: > listing.id]
  trip_id uuid [ref: > trip.id]
  created_at timestamptz [not null]
  Note: 'Check exactly one of listing_id, trip_id. Unique (user_id, listing_id) and (user_id, trip_id).'
}

// =====================================================================
// GEOGRAPHY
// =====================================================================

Table wilaya {
  code smallint [pk, note: 'Official code 1 to 69 (codes 59 to 69 to confirm with the JO and ONS).']
  name_fr varchar(80) [not null]
  name_ar varchar(80) [not null]
  name_en varchar(80) [not null]
  legacy_code_58 smallint [note: 'Code of the parent wilaya in the 58-wilaya system, for old data.']
  region varchar(16) [note: 'north, high_plateaus, south.']
  boundary "geometry(MultiPolygon,4326)"
  centroid "geography(Point,4326)"
  source varchar(64) [not null, note: 'Dataset name and commit, e.g. el-amin-dev@sha.']
  valid_from date [not null, note: '2026-04-05 for Loi 26-06 wilayas.']
}

Table daira {
  id int [pk]
  wilaya_code smallint [not null, ref: > wilaya.code]
  name_fr varchar(80) [not null]
  name_ar varchar(80) [not null]
}

Table commune {
  id int [pk, note: 'Official commune code.']
  wilaya_code smallint [not null, ref: > wilaya.code]
  daira_id int [ref: > daira.id]
  name_fr varchar(100) [not null]
  name_ar varchar(100) [not null]
  name_en varchar(100) [not null]
  postal_code varchar(5)
  centroid "geography(Point,4326)"
  source varchar(64) [not null]
  valid_from date [not null]
  Note: '1,541 rows. GIN trigram index on unaccent(name_fr) and name_ar for autocomplete.'
}

// =====================================================================
// HOST ACCOUNTS AND ORGANISATIONS
// =====================================================================

Table host_account {
  id uuid [pk]
  kind host_account_kind [not null]
  user_id uuid [unique, ref: - user.id, note: 'Set when kind = individual.']
  organization_id uuid [unique, ref: - organization.id, note: 'Set when kind = organization.']
  verification_status verification_status [not null, default: 'applied']
  status_before_delete verification_status
  default_approval_mode approval_mode [not null, default: 'request', note: 'Default for new listings (BR-BKG-02).']
  commission_rate_override_bp int [note: 'Null = use host-type default from settings. 0 to 10000.']
  credit_limit_override_minor bigint [note: 'Null = settings default for the host type (BR-PAY-10).']
  host_cancellations_12m int [not null, default: 0, note: 'Cache recomputed by job.']
  rating_avg numeric(3,2) [note: 'Cache from published reviews (BR-REV-04).']
  review_count int [not null, default: 0]
  submitted_at timestamptz [note: 'Last submission for review; drives queue waiting time.']
  approved_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz
  Note: 'The single thing that hosts: either one user (individual) or one organisation. Owns listings, trips, wallet and commission (resolves disagreement D-1). The active host account of a request comes from the session and is re-checked against membership on every call (workspace switcher, ORG-02). Check: (kind = individual and user_id not null and organization_id is null) or (kind = organization and organization_id not null and user_id is null).'
}

Table organization {
  id uuid [pk]
  business_category business_category [not null, note: 'Never changes after creation (BR-ORG-02).']
  display_name varchar(120) [not null]
  legal_name varchar(160)
  slug varchar(140) [unique, not null]
  description text
  source_language varchar(2) [not null, default: 'fr']
  logo_media_id uuid [ref: > media_asset.id]
  cover_media_id uuid [ref: > media_asset.id]
  business_email varchar(254)
  business_phone_e164 varchar(16)
  commune_id int [ref: > commune.id]
  address_line varchar(255)
  rc_number varchar(32) [note: 'Registre du commerce. Legal field (BR-ORG-06).']
  nif varchar(20) [note: 'Tax id. Legal field.']
  nis varchar(20) [note: 'Statistical id. Legal field.']
  article_imposition varchar(20)
  tourism_licence_number varchar(40) [note: 'Agencies. Legal field.']
  star_rating smallint [note: 'Hotels 1 to 5; drives tourist tax.']
  check_in_time time
  check_out_time time
  policies jsonb [note: 'Hostel age limits, curfew, other house policies.']
  team_size_range varchar(16)
  created_by_id uuid [not null, ref: > user.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz
}

Table membership {
  id uuid [pk]
  organization_id uuid [not null, ref: > organization.id]
  user_id uuid [not null, ref: > user.id]
  role membership_role [not null]
  is_active boolean [not null, default: true]
  joined_at timestamptz [not null]
  removed_at timestamptz
  Note: 'Unique (organization_id, user_id) where is_active. Partial unique (organization_id) where role = owner and is_active: exactly one owner (BR-ORG-04).'
}

Table invitation {
  id uuid [pk]
  organization_id uuid [not null, ref: > organization.id]
  email varchar(254)
  phone_e164 varchar(16)
  role membership_role [not null, note: 'Cannot be owner.']
  token_hash char(64) [unique, not null, note: 'SHA-256 of the one-time token; the token itself is only sent.']
  status invitation_status [not null, default: 'pending']
  invited_by_id uuid [not null, ref: > user.id]
  expires_at timestamptz [not null, note: 'Created + 7 days.']
  accepted_by_id uuid [ref: > user.id]
  accepted_at timestamptz
  created_at timestamptz [not null]
  Note: 'Check email or phone present. Partial unique (organization_id, lower(email)) where status = pending.'
}

Table host_document {
  id uuid [pk]
  host_account_id uuid [not null, ref: > host_account.id]
  listing_id uuid [ref: > listing.id, note: 'For per-vehicle or per-property documents.']
  doc_type document_type [not null]
  media_id uuid [not null, ref: > media_asset.id, note: 'Private bucket only.']
  status document_status [not null, default: 'pending']
  number_hash char(64) [note: 'HMAC of the document number, kept after the image is deleted (BR-PRV-05).']
  expires_on date
  reviewed_by_id uuid [ref: > user.id]
  reviewed_at timestamptz
  rejection_reason_id uuid [ref: > reason_code.id]
  created_at timestamptz [not null]
  deleted_at timestamptz
}

Table payout_account {
  id uuid [pk]
  host_account_id uuid [not null, ref: > host_account.id]
  kind varchar(16) [not null, note: 'ccp_rip, bank_rib, baridimob.']
  holder_name varchar(160) [not null]
  number_encrypted bytea [not null, note: 'Encrypted with a key outside the database.']
  number_last4 char(4) [not null]
  is_default boolean [not null, default: false]
  hold_until timestamptz [note: 'Changes block payouts for 72 h (BR-PAY-09).']
  created_at timestamptz [not null]
  deleted_at timestamptz
  Note: 'Used for refunds of deposit and, later, payouts (M4).'
}

// =====================================================================
// TAXONOMY
// =====================================================================

Table category {
  id uuid [pk]
  vertical vertical [not null]
  slug varchar(60) [not null]
  name_en varchar(80) [not null]
  name_fr varchar(80) [not null]
  name_ar varchar(80) [not null]
  icon varchar(40)
  sort_order int [not null, default: 0]
  is_active boolean [not null, default: true]
  indexes {
    (vertical, slug) [unique]
  }
}

Table property_type {
  id uuid [pk]
  vertical vertical [not null]
  slug varchar(60) [not null]
  name_en varchar(80) [not null]
  name_fr varchar(80) [not null]
  name_ar varchar(80) [not null]
  is_active boolean [not null, default: true]
  indexes {
    (vertical, slug) [unique]
  }
}

Table amenity {
  id uuid [pk]
  slug varchar(60) [unique, not null]
  group_code varchar(20) [not null, note: 'essentials, features, location, safety.']
  name_en varchar(80) [not null]
  name_fr varchar(80) [not null]
  name_ar varchar(80) [not null]
  icon varchar(40)
  applies_to "vertical[]" [not null, note: 'Which verticals may use it.']
  is_active boolean [not null, default: true]
  Note: 'One vocabulary replacing the three in the apps today.'
}

Table cancellation_policy {
  id uuid [pk]
  code varchar(20) [not null, note: 'flexible, moderate, strict (DEC-011).']
  version int [not null]
  name_en varchar(60) [not null]
  name_fr varchar(60) [not null]
  name_ar varchar(60) [not null]
  windows jsonb [not null, note: 'Ordered [{min_days_before, refund_bp}], see BR-CAN-01.']
  is_current boolean [not null]
  created_at timestamptz [not null]
  indexes {
    (code, version) [unique]
  }
  Note: 'Partial unique (code) where is_current. Bookings copy the windows (snapshot).'
}

// =====================================================================
// CATALOGUE: LISTINGS AND ROOM TYPES
// =====================================================================

Table listing {
  id uuid [pk]
  reference varchar(16) [unique, not null, note: 'Human id, e.g. LST-7K2M9Q.']
  host_account_id uuid [not null, ref: > host_account.id]
  vertical vertical [not null]
  status listing_status [not null, default: 'draft']
  status_before_delete listing_status
  inventory_kind inventory_kind [not null, note: 'single (home, vehicle), room_pool (hotel, hostel), slot (experience).']
  experience_type experience_type [note: 'Required when vertical = experience, null otherwise (DEC-015, BR-LST-05).']
  title varchar(120) [not null]
  description text [not null]
  source_language varchar(2) [not null]
  category_id uuid [ref: > category.id]
  property_type_id uuid [ref: > property_type.id]
  commune_id int [not null, ref: > commune.id]
  address_line varchar(255) [note: 'Private until a booking is confirmed (BR-SRC-03).']
  location_exact "geography(Point,4326)" [not null]
  location_public "geography(Point,4326)" [not null, note: 'Offset up to 500 m, fixed.']
  capacity_guests smallint [not null]
  bedrooms smallint
  beds smallint
  bathrooms numeric(3,1)
  surface_m2 int
  currency char(3) [not null, default: 'DZD']
  base_price_minor bigint [not null, note: 'Per night (stays), per day (vehicles), per person (experiences).']
  cleaning_fee_minor bigint [not null, default: 0]
  weekly_discount_bp int [not null, default: 0]
  monthly_discount_bp int [not null, default: 0]
  min_nights smallint [not null, default: 1]
  max_nights smallint [not null, default: 90]
  advance_notice_days smallint [not null, default: 0]
  available_from date
  available_until date
  check_in_time time
  check_out_time time
  approval_mode approval_mode [note: 'Null = inherit from host account (BR-BKG-02).']
  cancellation_policy_id uuid [not null, ref: > cancellation_policy.id]
  house_rules jsonb [note: 'List of rule codes plus free text.']
  rating_avg numeric(3,2)
  review_count int [not null, default: 0]
  submitted_at timestamptz
  published_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz
  Note: 'Checks: capacity_guests > 0; base_price_minor > 0; min_nights <= max_nights; discount bp between 0 and 9000; inventory_kind matches vertical (home/vehicle single, hotel/hostel room_pool, experience slot); (vertical = experience) = (experience_type is not null). Host offer rule (DEC-014, BR-HST-05): individual host accounts publish home and vehicle, agencies experience, hotels and hostels hotel/hostel; enforced by service and a trigger that reads host_account.kind and organization.business_category.'
}

Table listing_revision {
  id uuid [pk]
  listing_id uuid [not null, ref: > listing.id]
  payload jsonb [not null, note: 'Proposed values of reviewed fields (BR-LST-02).']
  status varchar(16) [not null, note: 'pending_review, approved, rejected, superseded.']
  submitted_by_id uuid [not null, ref: > user.id]
  submitted_at timestamptz [not null]
  decided_by_id uuid [ref: > user.id]
  decided_at timestamptz
  Note: 'Partial unique (listing_id) where status = pending_review.'
}

Table vehicle_detail {
  listing_id uuid [pk, ref: - listing.id]
  make varchar(40) [not null]
  model varchar(60) [not null]
  year smallint [not null]
  seats smallint [not null]
  transmission varchar(12) [not null, note: 'manual, automatic.']
  fuel varchar(12) [not null]
  daily_km_limit int
  driver_min_age smallint [not null, default: 25]
  licence_min_years smallint [not null, default: 2]
  security_deposit_minor bigint
}

Table experience_detail {
  listing_id uuid [pk, ref: - listing.id]
  duration_minutes int [not null]
  languages "varchar(2)[]" [not null]
  meeting_point "geography(Point,4326)"
  meeting_point_text varchar(255)
  max_group smallint [not null]
  includes jsonb
}

Table room_type {
  id uuid [pk]
  listing_id uuid [not null, ref: > listing.id]
  name varchar(80) [not null]
  description text
  booking_unit booking_unit [not null, note: 'room or bed (hostel dorms).']
  unit_count smallint [not null, note: 'Physical rooms or beds of this type (inventory total).']
  capacity_per_unit smallint [not null]
  base_price_minor bigint [not null]
  beds_description varchar(120)
  external_id varchar(80) [note: 'Id of this room type in the hotel system (DEC-017).']
  integration_id uuid [ref: > property_integration.id, note: 'Set when the room type is managed by a hotel system connection.']
  sort_order int [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  deleted_at timestamptz
  Note: 'Checks: unit_count > 0, capacity_per_unit > 0, base_price_minor > 0.'
}

Table listing_amenity {
  listing_id uuid [pk, ref: > listing.id]
  amenity_id uuid [pk, ref: > amenity.id]
}

Table room_type_amenity {
  room_type_id uuid [pk, ref: > room_type.id]
  amenity_id uuid [pk, ref: > amenity.id]
}

Table listing_photo {
  id uuid [pk]
  listing_id uuid [ref: > listing.id]
  room_type_id uuid [ref: > room_type.id]
  trip_id uuid [ref: > trip.id]
  media_id uuid [not null, ref: > media_asset.id]
  sort_order int [not null]
  caption varchar(160)
  is_cover boolean [not null, default: false]
  Note: 'Check exactly one of listing_id, trip_id (room photos also carry listing_id). Partial unique cover per listing and per trip.'
}

Table featured_placement {
  id uuid [pk]
  listing_id uuid [ref: > listing.id]
  trip_id uuid [ref: > trip.id]
  placement varchar(24) [not null, note: 'home_weekend, home_hero, search_top.']
  position smallint [not null, default: 0]
  starts_at timestamptz [not null]
  ends_at timestamptz
  created_by_id uuid [not null, ref: > user.id]
  created_at timestamptz [not null]
}

// =====================================================================
// INVENTORY AND CALENDAR
// =====================================================================

Table listing_day {
  listing_id uuid [pk, ref: > listing.id]
  day date [pk]
  is_blocked boolean [not null, default: false]
  price_override_minor bigint
  note varchar(120)
  Note: 'Host calendar for single-unit listings (homes, vehicles). Only rows that differ from defaults are stored.'
}

Table room_type_night {
  room_type_id uuid [pk, ref: > room_type.id]
  night date [pk]
  total smallint [not null, note: 'Units sellable that night (unit_count minus host blocks).']
  held smallint [not null, default: 0]
  booked smallint [not null, default: 0]
  price_override_minor bigint
  Note: 'Pooled inventory (BR-AVL-02). Check: held >= 0 and booked >= 0 and held + booked <= total. Rows created 18 months ahead by job.'
}

Table experience_slot {
  id uuid [pk]
  listing_id uuid [not null, ref: > listing.id]
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  seats_total smallint [not null]
  seats_held smallint [not null, default: 0]
  seats_booked smallint [not null, default: 0]
  price_override_minor bigint
  is_cancelled boolean [not null, default: false]
  indexes {
    (listing_id, starts_at) [unique]
  }
  Note: 'Check: seats_held + seats_booked <= seats_total, all >= 0.'
}

// =====================================================================
// TRIPS (agency only)
// =====================================================================

Table trip {
  id uuid [pk]
  reference varchar(16) [unique, not null]
  slug varchar(160) [unique, not null, note: 'Public URL name, e.g. 5-day-grand-tassili (the website links trips by slug).']
  host_account_id uuid [not null, ref: > host_account.id, note: 'Must be an approved agency (BR-TRP-01).']
  status listing_status [not null, default: 'draft']
  status_before_delete listing_status
  trip_type trip_type [not null, note: 'DEC-015.']
  title varchar(140) [not null]
  description text [not null]
  source_language varchar(2) [not null]
  duration_days smallint [not null]
  group_min smallint [not null, default: 1]
  group_max smallint [not null]
  currency char(3) [not null, default: 'DZD']
  price_per_person_minor bigint [not null]
  inclusions jsonb [not null]
  exclusions jsonb [not null]
  start_commune_id int [not null, ref: > commune.id]
  meeting_point "geography(Point,4326)"
  meeting_point_text varchar(255)
  cancellation_policy_id uuid [not null, ref: > cancellation_policy.id]
  approval_mode approval_mode
  rating_avg numeric(3,2)
  review_count int [not null, default: 0]
  submitted_at timestamptz
  published_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz
}

Table trip_itinerary_day {
  id uuid [pk]
  trip_id uuid [not null, ref: > trip.id]
  day_number smallint [not null]
  title varchar(120) [not null]
  description text
  overnight_commune_id int [ref: > commune.id]
  indexes {
    (trip_id, day_number) [unique]
  }
}

Table trip_departure {
  id uuid [pk]
  trip_id uuid [not null, ref: > trip.id]
  starts_on date [not null]
  ends_on date [not null]
  seats_total smallint [not null]
  seats_held smallint [not null, default: 0]
  seats_booked smallint [not null, default: 0]
  price_per_person_minor bigint [note: 'Null = trip price.']
  status departure_status [not null, default: 'scheduled']
  guide_membership_id uuid [ref: > membership.id]
  created_at timestamptz [not null]
  indexes {
    (trip_id, starts_on) [unique]
  }
  Note: 'Check: ends_on >= starts_on; seats_held + seats_booked <= seats_total (BR-TRP-02).'
}

// =====================================================================
// PRICING
// =====================================================================

Table quote {
  id uuid [pk]
  guest_id uuid [ref: > user.id]
  listing_id uuid [ref: > listing.id]
  room_type_id uuid [ref: > room_type.id]
  experience_slot_id uuid [ref: > experience_slot.id]
  trip_departure_id uuid [ref: > trip_departure.id]
  stay daterange [note: '[check-in, check-out).']
  guests smallint [not null]
  units smallint [not null, default: 1]
  currency char(3) [not null]
  lines jsonb [not null, note: 'Per-night prices, discount, cleaning, taxes.']
  subtotal_minor bigint [not null]
  discount_minor bigint [not null, default: 0]
  cleaning_fee_minor bigint [not null, default: 0]
  taxes_minor bigint [not null, default: 0]
  total_minor bigint [not null]
  expires_at timestamptz [not null, note: 'Created + 30 min (BR-PRC-01).']
  created_at timestamptz [not null]
  Note: 'Short-lived; purged after 7 days by job.'
}

Table tax_rate {
  id uuid [pk]
  kind varchar(16) [not null, note: 'taxe_sejour, vat.']
  star_rating smallint [note: 'Taxe de sejour by hotel stars; null = unclassified.']
  rate_bp int [note: 'VAT.']
  amount_per_person_night_minor bigint [note: 'Taxe de sejour.']
  valid_from date [not null]
  valid_to date
  Note: 'R2. Values VERIFY WITH A PROFESSIONAL.'
}

// =====================================================================
// BOOKINGS
// =====================================================================

Table booking {
  id uuid [pk]
  reference varchar(20) [unique, not null, note: 'BLD-YYYY-XXXXXX.']
  guest_id uuid [not null, ref: > user.id]
  host_account_id uuid [not null, ref: > host_account.id]
  inventory_kind inventory_kind [not null]
  listing_id uuid [ref: > listing.id]
  room_type_id uuid [ref: > room_type.id]
  experience_slot_id uuid [ref: > experience_slot.id]
  trip_departure_id uuid [ref: > trip_departure.id]
  stay daterange [not null, note: 'Half-open [check-in, check-out). For slots and departures: their dates.']
  check_in_at timestamptz [not null]
  check_out_at timestamptz [not null]
  guests_adults smallint [not null]
  guests_children smallint [not null, default: 0]
  units smallint [not null, default: 1, note: 'Rooms, beds or seats.']
  status booking_status [not null]
  payment_status payment_status [not null, default: 'not_collected']
  approval_mode_applied approval_mode [not null]
  request_expires_at timestamptz [note: 'Set for pending (BR-BKG-04).']
  confirmed_at timestamptz
  completed_at timestamptz
  cancelled_at timestamptz
  cancelled_by_role actor_role
  cancelled_by_id uuid [ref: > user.id]
  cancel_reason_id uuid [ref: > reason_code.id]
  decline_reason_id uuid [ref: > reason_code.id]
  currency char(3) [not null]
  subtotal_minor bigint [not null]
  discount_minor bigint [not null, default: 0]
  cleaning_fee_minor bigint [not null, default: 0]
  taxes_minor bigint [not null, default: 0]
  total_minor bigint [not null]
  commission_base_minor bigint [not null, note: 'DEC-002.']
  commission_rate_bp int [not null, note: 'Snapshot at creation.']
  commission_minor bigint [not null]
  refund_due_minor bigint [not null, default: 0, note: 'Cumulative amount owed back to the guest.']
  price_lines jsonb [not null]
  cancellation_windows jsonb [not null, note: 'Snapshot of policy windows.']
  listing_snapshot jsonb [not null, note: 'Title, photo, address at booking time.']
  quote_id uuid [ref: > quote.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes {
    (host_account_id, status, check_in_at) [note: 'Q5 host lists']
    (guest_id, created_at) [note: 'Q6 guest lists']
    request_expires_at [note: 'Q11, partial WHERE status = pending']
    check_out_at [note: 'Q12, partial WHERE status = confirmed']
  }
  Note: '''Checks: exactly the target columns matching inventory_kind are set; total_minor = subtotal - discount + cleaning + taxes; 0 <= refund_due_minor <= total_minor; guests_adults >= 1.
Exclusion (BR-AVL-01): EXCLUDE USING gist (listing_id WITH =, stay WITH &&) WHERE (inventory_kind = 'single' AND status IN ('awaiting_payment','pending','confirmed','completed','disputed')).'''
}

Table booking_event {
  id bigint [pk, increment]
  booking_id uuid [not null, ref: > booking.id]
  from_status booking_status
  to_status booking_status [not null]
  actor_role actor_role [not null]
  actor_id uuid [ref: > user.id]
  reason_id uuid [ref: > reason_code.id]
  note text
  created_at timestamptz [not null]
  Note: 'Append-only history of every status change.'
}

Table refund {
  id uuid [pk]
  booking_id uuid [not null, ref: > booking.id]
  amount_minor bigint [not null]
  kind varchar(20) [not null, note: 'policy, host_cancel, staff, dispute.']
  settlement varchar(20) [not null, default: 'owed_by_host', note: 'M1: owed_by_host, settled_confirmed. M4: via gateway.']
  reason text
  created_by_id uuid [ref: > user.id]
  created_at timestamptz [not null]
  Note: 'Check amount_minor > 0. Sum per booking equals booking.refund_due_minor.'
}

Table dispute {
  id uuid [pk]
  booking_id uuid [unique, not null, ref: > booking.id]
  opened_by_id uuid [not null, ref: > user.id]
  opened_by_role actor_role [not null]
  reason_id uuid [ref: > reason_code.id]
  guest_statement text
  host_statement text
  outcome varchar(16) [note: 'refund_full, refund_partial, declined.']
  refund_minor bigint
  resolution_note text
  resolved_by_id uuid [ref: > user.id]
  resolved_at timestamptz
  created_at timestamptz [not null]
  Note: 'R2.'
}

// =====================================================================
// MONEY: LEDGER, WALLET, DORMANT PAYMENTS
// =====================================================================

Table ledger_account {
  id uuid [pk]
  code varchar(80) [unique, not null, note: 'e.g. host_wallet:<host_account_id>, platform_cash:ccp_transfer.']
  kind ledger_account_kind [not null]
  host_account_id uuid [ref: > host_account.id]
  currency char(3) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  Note: 'Partial unique (host_account_id, kind) where host_account_id is not null.'
}

Table ledger_transaction {
  id uuid [pk]
  kind ledger_tx_kind [not null]
  booking_id uuid [ref: > booking.id]
  topup_id uuid [ref: > wallet_topup.id]
  reverses_id uuid [ref: > ledger_transaction.id, note: 'For reversals and corrections.']
  description varchar(255) [not null]
  created_by_id uuid [ref: > user.id, note: 'Null = system.']
  occurred_at timestamptz [not null]
  created_at timestamptz [not null]
  Note: 'Insert-only. Partial unique (booking_id) where kind = commission (BR-PAY-04).'
}

Table ledger_entry {
  id bigint [pk, increment]
  transaction_id uuid [not null, ref: > ledger_transaction.id]
  account_id uuid [not null, ref: > ledger_account.id]
  amount_minor bigint [not null, note: 'Positive = debit, negative = credit. Never 0.']
  currency char(3) [not null]
  Note: 'Insert-only. Deferred constraint trigger: per transaction and currency, sum(amount_minor) = 0 (BR-PAY-02).'
}

Table account_balance {
  account_id uuid [pk, ref: - ledger_account.id]
  balance_minor bigint [not null]
  last_entry_id bigint [not null]
  updated_at timestamptz [not null]
  Note: 'Cache updated in the same transaction as entries (row lock). Nightly job checks it equals the sum.'
}

Table wallet_topup {
  id uuid [pk]
  host_account_id uuid [not null, ref: > host_account.id]
  method topup_method [not null]
  amount_minor bigint [not null, note: '1 to 10,000,000 DZD in centimes.']
  receipt_reference varchar(200) [not null]
  status topup_status [not null]
  requested_by_id uuid [not null, ref: > user.id]
  approved_by_id uuid [ref: > user.id, note: 'Second finance user above 500,000 DZD (BR-PAY-07).']
  approved_at timestamptz
  rejection_reason text
  gateway_event_id uuid [ref: > gateway_event.id]
  created_at timestamptz [not null]
  indexes {
    (method, receipt_reference) [unique]
  }
}

Table gateway_event {
  id uuid [pk]
  provider varchar(20) [not null, note: 'chargily, slickpay.']
  event_id varchar(100) [not null]
  signature_valid boolean [not null]
  payload jsonb [not null]
  received_at timestamptz [not null]
  processed_at timestamptz
  error text
  indexes {
    (provider, event_id) [unique]
  }
  Note: 'R2. Raw webhooks (BR-SYS-02).'
}

Table payment {
  id uuid [pk]
  booking_id uuid [ref: > booking.id]
  provider varchar(20) [not null]
  provider_checkout_id varchar(100) [not null]
  amount_minor bigint [not null]
  currency char(3) [not null]
  status varchar(16) [not null]
  created_at timestamptz [not null]
  Note: 'DORMANT until money model M2 to M4 is approved (BR-PAY-11).'
}

Table payout {
  id uuid [pk]
  host_account_id uuid [not null, ref: > host_account.id]
  payout_account_id uuid [not null, ref: > payout_account.id]
  amount_minor bigint [not null]
  status varchar(16) [not null, note: 'requested, approved, sent, confirmed, rejected.']
  approved_by_id uuid [ref: > user.id]
  ledger_transaction_id uuid [ref: > ledger_transaction.id]
  created_at timestamptz [not null]
  Note: 'DORMANT (M4). Also used for deposit withdrawals in M1 if the product allows them.'
}

Table invoice {
  id uuid [pk]
  host_account_id uuid [not null, ref: > host_account.id]
  year smallint [not null]
  number int [not null]
  period_start date [not null]
  period_end date [not null]
  amount_ht_minor bigint [not null]
  vat_minor bigint [not null]
  amount_ttc_minor bigint [not null]
  status varchar(12) [not null, note: 'issued, cancelled.']
  pdf_media_id uuid [ref: > media_asset.id]
  credit_note_of_id uuid [ref: > invoice.id]
  issued_at timestamptz [not null]
  indexes {
    (year, number) [unique]
  }
  Note: 'R2. Commission invoices (BR-PAY-12). VERIFY WITH A PROFESSIONAL.'
}

// =====================================================================
// REVIEWS
// =====================================================================

Table review {
  id uuid [pk]
  booking_id uuid [not null, ref: > booking.id]
  author_id uuid [not null, ref: > user.id]
  author_role actor_role [not null, note: 'guest or host.']
  listing_id uuid [ref: > listing.id]
  trip_id uuid [ref: > trip.id]
  host_account_id uuid [not null, ref: > host_account.id]
  rating_overall smallint [not null]
  rating_cleanliness smallint
  rating_accuracy smallint
  rating_communication smallint
  rating_location smallint
  rating_value smallint
  comment text [not null]
  language varchar(2) [not null]
  status review_status [not null, default: 'submitted']
  submitted_at timestamptz [not null]
  published_at timestamptz
  indexes {
    (booking_id, author_role) [unique]
  }
  Note: 'Ratings between 1 and 5. Window: 14 days after check-out (BR-REV-01).'
}

Table review_reply {
  review_id uuid [pk, ref: - review.id]
  author_id uuid [not null, ref: > user.id]
  body text [not null]
  created_at timestamptz [not null]
  editable_until timestamptz [not null]
}

Table review_report {
  id uuid [pk]
  review_id uuid [not null, ref: > review.id]
  reporter_id uuid [not null, ref: > user.id]
  reason_id uuid [not null, ref: > reason_code.id]
  note text
  status varchar(12) [not null, note: 'open, dismissed, actioned.']
  created_at timestamptz [not null]
  indexes {
    (review_id, reporter_id) [unique]
  }
}

// =====================================================================
// MESSAGING AND NOTIFICATIONS
// =====================================================================

Table conversation {
  id uuid [pk]
  kind conversation_kind [not null]
  guest_id uuid [ref: > user.id]
  host_account_id uuid [ref: > host_account.id]
  listing_id uuid [ref: > listing.id]
  trip_id uuid [ref: > trip.id]
  booking_id uuid [ref: > booking.id]
  last_message_at timestamptz
  created_at timestamptz [not null]
  Note: 'Partial unique (booking_id) where not null; partial unique (guest_id, listing_id) where kind = inquiry.'
}

Table conversation_participant {
  conversation_id uuid [pk, ref: > conversation.id]
  user_id uuid [pk, ref: > user.id]
  role varchar(12) [not null, note: 'guest, host_member, staff.']
  last_read_message_id bigint
  muted boolean [not null, default: false]
  joined_at timestamptz [not null]
}

Table message {
  id bigint [pk, increment, note: 'Ordered id, used as sync cursor (MSG-02).']
  conversation_id uuid [not null, ref: > conversation.id]
  sender_id uuid [ref: > user.id, note: 'Null for system messages.']
  kind varchar(12) [not null, note: 'text, system.']
  body text [not null]
  body_masked text [note: 'Shown to the other side before confirmation (BR-MSG-01).']
  contains_contact_info boolean [not null, default: false]
  created_at timestamptz [not null]
  deleted_at timestamptz
  indexes {
    (conversation_id, id)
  }
}

Table notification {
  id bigint [pk, increment]
  user_id uuid [not null, ref: > user.id]
  kind varchar(48) [not null]
  params jsonb [not null, note: 'Values for the localized template.']
  link varchar(255)
  read_at timestamptz
  created_at timestamptz [not null]
  indexes {
    (user_id, read_at, id)
  }
}

Table notification_preference {
  user_id uuid [pk, ref: > user.id]
  kind varchar(48) [pk]
  channel varchar(8) [pk, note: 'email, sms, push.']
  enabled boolean [not null]
}

Table outbox_event {
  id bigint [pk, increment]
  topic varchar(64) [not null]
  aggregate_type varchar(32) [not null]
  aggregate_id uuid [not null]
  payload jsonb [not null]
  status outbox_status [not null, default: 'pending']
  attempts smallint [not null, default: 0]
  next_attempt_at timestamptz [not null]
  created_at timestamptz [not null]
  sent_at timestamptz
  indexes {
    (status, next_attempt_at)
  }
  Note: 'Written in the same transaction as the change (BR-SYS-03).'
}

Table delivery_log {
  id bigint [pk, increment]
  outbox_event_id bigint [ref: > outbox_event.id]
  channel varchar(8) [not null]
  provider varchar(20) [not null]
  recipient_hash char(64) [not null]
  status varchar(12) [not null]
  provider_message_id varchar(100)
  cost_minor bigint
  error text
  created_at timestamptz [not null]
}

// =====================================================================
// MEDIA
// =====================================================================

Table media_asset {
  id uuid [pk]
  owner_user_id uuid [ref: > user.id]
  host_account_id uuid [ref: > host_account.id]
  purpose varchar(20) [not null, note: 'listing_photo, document, avatar, logo, invoice, export.']
  bucket media_bucket [not null]
  storage_key varchar(255) [unique, not null]
  mime_type varchar(64) [not null]
  size_bytes bigint [not null]
  width int
  height int
  sha256 char(64) [not null]
  phash bigint [note: 'Perceptual hash for duplicate photos (BR-MED-01).']
  status media_status [not null, default: 'quarantined']
  scan_result varchar(32)
  created_at timestamptz [not null]
  deleted_at timestamptz
  indexes {
    phash
  }
}

// =====================================================================
// MODERATION, CONFIG, AUDIT, PRIVACY, SYSTEM
// =====================================================================

Table reason_code {
  id uuid [pk]
  action varchar(32) [not null, note: 'reject_listing, decline_booking, cancel_booking, report_review ...']
  code varchar(48) [not null]
  label_en varchar(120) [not null]
  label_fr varchar(120) [not null]
  label_ar varchar(120) [not null]
  host_text_en text
  host_text_fr text
  host_text_ar text
  is_active boolean [not null, default: true]
  indexes {
    (action, code) [unique]
  }
}

Table moderation_case {
  id uuid [pk]
  kind case_kind [not null]
  subject_type varchar(24) [not null]
  subject_id uuid [not null]
  status case_status [not null, default: 'open']
  priority case_priority [not null, default: 'normal']
  submitted_at timestamptz [not null, note: 'Waiting time counts from here (BR-MOD-01).']
  assigned_to_id uuid [ref: > user.id]
  resolved_by_id uuid [ref: > user.id]
  resolved_at timestamptz
  outcome varchar(24)
  created_at timestamptz [not null]
  indexes {
    (status, kind, submitted_at)
  }
  Note: 'Partial unique (kind, subject_id) where status <> resolved.'
}

Table moderation_decision {
  id uuid [pk]
  case_id uuid [not null, ref: > moderation_case.id]
  decision varchar(24) [not null]
  reason_id uuid [ref: > reason_code.id]
  note text
  actor_id uuid [not null, ref: > user.id]
  created_at timestamptz [not null]
}

Table change_request_item {
  id uuid [pk]
  case_id uuid [not null, ref: > moderation_case.id]
  checklist_code varchar(48) [not null]
  message text
  resolved_at timestamptz
}

Table platform_settings {
  id uuid [pk]
  version int [unique, not null]
  data jsonb [not null, note: 'Validated whitelist: commission defaults (bp), credit limits, request_ttl_hours, instant_booking_enabled, maintenance_mode, staff session timeouts, locales, feature flags.']
  is_current boolean [not null]
  created_by_id uuid [not null, ref: > user.id]
  created_at timestamptz [not null]
  Note: 'Partial unique (is_current) where is_current. New row per change (BR-CFG-01).'
}

Table onboarding_flow_version {
  id uuid [pk]
  host_type varchar(12) [not null, note: 'individual, agency, hotel, hostel.']
  version int [not null]
  status flow_status [not null]
  schema jsonb [not null, note: 'Steps and fields with canonical types (BR-CFG-03).']
  published_by_id uuid [ref: > user.id]
  published_at timestamptz
  created_at timestamptz [not null]
  indexes {
    (host_type, version) [unique]
  }
  Note: 'Partial unique (host_type) where status = draft; partial unique (host_type) where status = published.'
}

Table onboarding_draft {
  id uuid [pk]
  user_id uuid [not null, ref: > user.id]
  host_type varchar(12) [not null]
  flow_version_id uuid [not null, ref: > onboarding_flow_version.id]
  current_step varchar(48) [not null]
  answers jsonb [not null]
  status varchar(12) [not null, note: 'in_progress, submitted, abandoned.']
  host_account_id uuid [ref: > host_account.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: 'Partial unique (user_id, host_type) where status = in_progress.'
}

Table coupon {
  id uuid [pk]
  code varchar(32) [not null]
  discount_type varchar(12) [not null, note: 'percentage, fixed.']
  discount_value bigint [not null, note: 'bp or centimes.']
  min_spend_minor bigint [not null, default: 0]
  funded_by varchar(8) [not null, note: 'platform, host (BR-PRM-02).']
  host_account_id uuid [ref: > host_account.id]
  scope_verticals "vertical[]"
  usage_limit int
  per_user_limit int [not null, default: 1]
  valid_from timestamptz [not null]
  valid_to timestamptz
  is_active boolean [not null, default: true]
  created_by_id uuid [not null, ref: > user.id]
  created_at timestamptz [not null]
  Note: 'R2. Unique lower(code).'
}

Table coupon_redemption {
  id uuid [pk]
  coupon_id uuid [not null, ref: > coupon.id]
  booking_id uuid [unique, not null, ref: > booking.id]
  user_id uuid [not null, ref: > user.id]
  amount_minor bigint [not null]
  released_at timestamptz
  created_at timestamptz [not null]
}

Table audit_event {
  id bigint [pk, increment]
  occurred_at timestamptz [not null]
  actor_id uuid [ref: > user.id]
  actor_kind varchar(8) [not null, note: 'staff, user, system.']
  actor_role varchar(16)
  action varchar(48) [not null, note: 'e.g. LISTING_APPROVE, WALLET_TOPUP (53 kinds today).']
  object_type varchar(24) [not null]
  object_id varchar(64) [not null]
  host_account_id uuid [ref: > host_account.id]
  before jsonb
  after jsonb
  ip inet
  user_agent varchar(255)
  request_id varchar(36)
  prev_hash char(64) [not null]
  hash char(64) [not null]
  indexes {
    (object_type, object_id, occurred_at)
    (actor_id, occurred_at)
  }
  Note: 'Insert-only for the app role; hash chain (BR-STF-02). Partitioned by month.'
}

Table export_job {
  id uuid [pk]
  requested_by_id uuid [not null, ref: > user.id]
  dataset varchar(32) [not null]
  filters jsonb [not null]
  row_count int
  status varchar(12) [not null]
  media_id uuid [ref: > media_asset.id]
  created_at timestamptz [not null]
  completed_at timestamptz
}

Table data_subject_request {
  id uuid [pk]
  user_id uuid [not null, ref: > user.id]
  kind dsr_kind [not null]
  status varchar(12) [not null]
  due_at timestamptz [not null]
  handled_by_id uuid [ref: > user.id]
  completed_at timestamptz
  notes text
  created_at timestamptz [not null]
}

Table idempotency_record {
  id uuid [pk]
  user_id uuid [not null, ref: > user.id]
  endpoint varchar(80) [not null]
  key varchar(80) [not null]
  request_hash char(64) [not null]
  status varchar(12) [not null, note: 'in_progress, completed.']
  response_code smallint
  response_body jsonb
  locked_until timestamptz
  created_at timestamptz [not null]
  expires_at timestamptz [not null, note: 'Created + 24 h (BR-SYS-01).']
  indexes {
    (user_id, endpoint, key) [unique]
  }
}

Table incident_record {
  id uuid [pk]
  kind varchar(24) [not null, note: 'security_breach, data_leak, outage, fraud.']
  severity varchar(8) [not null, note: 'low, medium, high, critical.']
  detected_at timestamptz [not null]
  personal_data_involved boolean [not null]
  anpdp_deadline_at timestamptz [note: 'detected_at + 5 days when personal data is involved (Law 18-07 as amended, VERIFY WITH A PROFESSIONAL).']
  anpdp_notified_at timestamptz
  users_notified_at timestamptz
  summary text [not null]
  actions_taken text
  owner_id uuid [not null, ref: > user.id]
  closed_at timestamptz
  created_at timestamptz [not null]
  Note: 'Incident register and breach clock (PRV-05). Staff-only, audited.'
}

Table calendar_feed {
  id uuid [pk]
  listing_id uuid [not null, ref: > listing.id]
  room_type_id uuid [ref: > room_type.id]
  direction varchar(8) [not null, note: 'import or export.']
  url_encrypted bytea [note: 'Import URL (other platform), encrypted; fetched through the egress proxy with private-IP blocking (SSRF control).']
  export_token_hash char(64) [note: 'Hash of the secret token in the export URL.']
  last_synced_at timestamptz
  last_error text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  Note: 'Later release (AVL-06): iCal import and export.'
}

Table otp_send_log {
  id bigint [pk, increment]
  phone_hash char(64) [not null, note: 'HMAC of the phone number.']
  ip inet
  purpose varchar(16) [not null, note: 'signup, login, phone_change, payout_change.']
  provider varchar(20) [not null]
  status varchar(12) [not null, note: 'sent, failed, blocked_rate_limit.']
  cost_minor bigint
  created_at timestamptz [not null]
  indexes {
    (phone_hash, created_at)
    (ip, created_at)
  }
  Note: 'Record of every one-time code sent (codes themselves stay in Redis, never stored). Feeds SMS budget alarms and pumping-fraud detection (ACC-02, BR-ACC-02). Kept 90 days.'
}

Table property_integration {
  id uuid [pk]
  organization_id uuid [not null, ref: > organization.id]
  listing_id uuid [ref: > listing.id, note: 'The hotel or hostel property this connection feeds.']
  kind varchar(20) [not null, note: 'channel_manager, pms, ical, csv_import.']
  system_name varchar(60) [not null, note: 'Name of the hotel system as the hotel gave it.']
  base_url varchar(255)
  credentials_encrypted bytea [note: 'API key or login of the hotel system, encrypted with a key outside the database.']
  status varchar(12) [not null, default: 'pending', note: 'pending, active, error, disabled.']
  sync_rooms boolean [not null, default: true]
  sync_availability boolean [not null, default: true]
  sync_services boolean [not null, default: true]
  last_synced_at timestamptz
  last_error text
  created_by_id uuid [not null, ref: > user.id]
  created_at timestamptz [not null]
  Note: 'Direct connection to a hotel system (DEC-017, HST-08). Room types, per-night availability, prices and services are pulled from it. BLADUS stays the source of truth for bookings made on BLADUS and pushes them back when the system allows it.'
}

Table integration_sync_log {
  id bigint [pk, increment]
  integration_id uuid [not null, ref: > property_integration.id]
  started_at timestamptz [not null]
  finished_at timestamptz
  status varchar(12) [not null, note: 'ok, partial, failed.']
  rooms_changed int [not null, default: 0]
  nights_changed int [not null, default: 0]
  services_changed int [not null, default: 0]
  error text
  Note: 'One row per sync run, so the hotel and the admin can see what was imported and why a sync failed.'
}

Table property_service {
  id uuid [pk]
  listing_id uuid [not null, ref: > listing.id]
  kind varchar(24) [not null, note: 'restaurant, cafe, spa, pool, gym, parking, conference_room, airport_transfer, other.']
  name varchar(120) [not null]
  description text
  opening_hours jsonb
  price_minor bigint [note: 'Null = included or price on request.']
  external_id varchar(80) [note: 'Id of the service in the hotel system.']
  source varchar(12) [not null, default: 'manual', note: 'manual or integration.']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  Note: 'Services of a hotel or hostel (restaurants, spa, parking...), typed by the host or imported from the hotel system.'
}

Table listing_search_doc {
  listing_id uuid [pk, ref: - listing.id]
  vertical vertical [not null]
  wilaya_code smallint [not null]
  commune_id int [not null]
  location_public "geography(Point,4326)" [not null]
  price_from_minor bigint [not null]
  capacity_guests smallint [not null]
  rating_avg numeric(3,2)
  review_count int [not null]
  instant_bookable boolean [not null]
  host_type varchar(12) [not null]
  experience_type experience_type [note: 'For the experience type filter and facet counts.']
  property_type_id uuid
  amenity_ids "uuid[]" [not null]
  tsv_fr tsvector
  tsv_en tsvector
  tsv_ar tsvector
  search_text text [note: 'Title and place names, unaccented, for trigram search.']
  published_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: 'Denormalised row per published listing, refreshed by outbox job. GiST on location_public, GIN on amenity_ids, tsv_* and search_text (gin_trgm_ops).'
}
