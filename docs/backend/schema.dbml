// BLADUS database schema (PostgreSQL 17 + PostGIS 3.5)
// Documentation artifact, not a migration. Source of truth for 05-database-schema.md,
// 05b-data-dictionary.md and the ERD diagrams (generated by _tools/build_schema_docs.py).
// Conventions: primary keys are UUIDv7 generated by the app unless noted; money is BIGINT
// centimes ("_minor") with a currency char(3) = 'DZD'; rates are basis points ("_bp");
// timestamps are timestamptz in UTC; stay dates are date in Africa/Algiers.
// Constraints DBML cannot express (exclusion, partial unique, check, triggers) are listed
// in each table Note and written as SQL in 05-database-schema.md section 6.

Project bladus {
  database_type: 'PostgreSQL'
  Note: 'BLADUS marketplace: homes, hotels, hostels, experiences, vehicles, agency trips. Money model M1 (prepaid commission) with dormant tables for M2 to M4.'
}

// =====================================================================
// ENUMS
// =====================================================================

Enum user_status {
  active
  suspended
  banned
  deleted
}
Enum staff_role_code {
  admin
}
Enum staff_status {
  invited
  active
  deactivated
}
Enum host_account_kind {
  individual
  organization
}
Enum business_category {
  agency
  hotel
  hostel
}
Enum verification_status {
  applied
  under_review
  changes_requested
  approved
  rejected
  suspended
  banned
}
Enum membership_role {
  owner
  admin
  manager
  agent
  guide
}
Enum invitation_status {
  pending
  accepted
  revoked
  expired
}
Enum document_type {
  national_id
  passport
  property_proof
  lease_authorisation
  apc_declaration
  insurance
  auto_entrepreneur_card
  commercial_register
  tax_card_nif
  statistics_nis
  tourism_licence
  hotel_classification
  operating_authorisation
  vehicle_registration
  vehicle_insurance
  technical_inspection
  driving_licence
}
Enum document_status {
  pending
  approved
  rejected
  expired
}
Enum approval_mode {
  instant
  request
}
Enum vertical {
  home
  hotel
  hostel
  experience
  vehicle
}
Enum experience_type {
