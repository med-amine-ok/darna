  guided_tour
  nature_adventure
  desert
  sport
  culture_workshop
  gastronomy
  wellness
}
Enum trip_type {
  group_tour
  private_trip
  adventure
  desert_expedition
  cultural
  hiking
  relaxation
  religious
}
Enum listing_status {
  draft
  pending_review
  changes_requested
  published
  paused
  rejected
  suspended
  archived
  deleted
}
Enum booking_unit {
  room
  bed
}
Enum inventory_kind {
  single
  room_pool
  slot
  departure
}
Enum booking_status {
  awaiting_payment
  pending
  confirmed
  declined
  expired
  cancelled
  completed
  disputed
}
Enum payment_status {
  not_collected
  awaiting
  paid
  partially_refunded
  refunded
  failed
}
Enum actor_role {
  guest
  host
  staff
  system
}
Enum departure_status {
  scheduled
  guaranteed
  cancelled
  completed
}
Enum ledger_account_kind {
  host_wallet
  platform_cash
  commission_revenue
  vat_payable
  guest_receivable
  escrow
  host_payable
  payout_clearing
  adjustments
}
Enum ledger_tx_kind {
  wallet_topup
  commission
  commission_reversal
  adjustment
  guest_payment
  refund
  payout
}
Enum topup_method {
  ccp_transfer
  bank_transfer
  baridimob
  cash_office
  gateway
}
Enum topup_status {
  pending_approval
  approved
  rejected
}
Enum review_status {
  submitted
  published
  flagged
  hidden
  removed
}
Enum conversation_kind {
  inquiry
  booking
  support
}
Enum media_status {
  quarantined
  ready
  rejected
  deleted
}
Enum media_bucket {
  public
  private
}
Enum case_kind {
  host_verification
  listing_review
  listing_revision
  trip_review
  document
  review_report
  dispute
  risk_flag
  legal_change
