# Admin session signing key (HS256). REQUIRED in production, >= 32 chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_AUTH_SECRET=change-me-to-a-long-random-secret

# Seed staff accounts (mock data). Outside production, built-in dev defaults
# are used when these are unset; in production an account without a password
# variable cannot sign in.
ADMIN_SEED_EMAIL=admin@darna.dz
ADMIN_SEED_PASSWORD=
ADMIN_SEED_PASSWORD_MODERATOR=
ADMIN_SEED_PASSWORD_SUPPORT=
ADMIN_SEED_PASSWORD_FINANCE=
ADMIN_SEED_PASSWORD_ANALYST=

# Public origin of the guest/host site (frontend app), used for "view public profile" links.
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
