# Copy to .env and adjust. Never commit .env.
# DJANGO_DEBUG=True is for a developer laptop only; production must use False
# with real DJANGO_SECRET_KEY, HASH_PEPPER and INTEGRATION_KEYS.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL in staging and production; leave empty to use SQLite locally.
# DATABASE_URL=postgres://bladus:password@localhost:5432/bladus
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
SMS_BACKEND=apps.accounts.sms.ConsoleSmsBackend

# R9 security controls. HASH_PEPPER and INTEGRATION_KEYS are required when DJANGO_DEBUG=False.
# Server secret for HMAC-SHA256 of session tokens, one-time codes and lookup
# hashes. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everybody out and voids unused codes and invitations.
# HASH_PEPPER=generate-a-long-random-value
# Fernet keys for hotel system credentials, comma separated. The first key
# encrypts, all keys decrypt (rotation: put the new key first, run the
# re-encryption, then drop the old key). Generate one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty in development: a key is derived from DJANGO_SECRET_KEY when DJANGO_DEBUG=True.
# INTEGRATION_KEYS=new-key,old-key
# One-time code and SMS limits (defaults shown).
# OTP_MAX_SENDS_PER_HOUR=3
# OTP_MAX_SENDS_PER_DAY=10
# OTP_MAX_SENDS_PER_IP_PER_HOUR=10
# SMS_DAILY_BUDGET=5000

# Email and website links. Console email in development; SMTP when DJANGO_DEBUG=False.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=BLADUS <no-reply@bladus.dz>
# FRONTEND_URL=http://localhost:3000

# Uploads (BR-MED-01, BR-MED-02). Local folder in development; production needs s3 and a real scanner.
# MEDIA_STORAGE_BACKEND=s3
# MEDIA_LOCAL_ROOT=var/media
# MEDIA_SCANNER=dotted.path.to.ClamAvScanner
# MEDIA_S3_ENDPOINT_URL=
# MEDIA_S3_REGION=
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_S3_BUCKET_QUARANTINE=
# MEDIA_S3_BUCKET_PUBLIC=
# MEDIA_S3_BUCKET_PRIVATE=
# MEDIA_PUBLIC_BASE_URL=

# CSV exports (development folder; production uses private storage).
# EXPORTS_ROOT=var/exports

# Payment gateway webhook secrets (online payment is off in the first release, DEC-019).
# CHARGILY_WEBHOOK_SECRET=
# SLICKPAY_WEBHOOK_SECRET=

# Proxies in front of Django that append to X-Forwarded-For (Caddy, then the website or admin server).
# 0 = ignore the header and use the socket address. Never set it higher than the real number of hops.
# TRUSTED_PROXY_HOPS=0

# Admin panel second step with an authenticator app (BR-ACC-04). Off for now: the password alone opens the admin.
# Set to True before real staff use the admin in production.
# STAFF_MFA_REQUIRED=False
