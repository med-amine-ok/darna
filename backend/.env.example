# Copy to .env and adjust. Never commit .env.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL in staging and production; leave empty to use SQLite locally.
# DATABASE_URL=postgres://bladus:password@localhost:5432/bladus
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
SMS_BACKEND=apps.accounts.sms.ConsoleSmsBackend
